# Copy to .env and replace every value marked `change-me` before starting.
PAPLY_ENVIRONMENT=development
COMPOSE_PROJECT_NAME=paplyai-gateway
PAPLY_PUBLIC_BASE_URL=http://127.0.0.1:4387
# Temporary operator endpoint. Set both values when the LiteLLM UI is exposed
# through an IP address and port; use HTTPS and a reverse proxy in production.
PAPLY_LITELLM_UI_PUBLIC_URL=http://127.0.0.1:4000
PAPLY_LITELLM_UI_BIND_ADDRESS=127.0.0.1

# Python package index used only while building the Gateway/Admin image.
# Domestic servers can use https://mirrors.aliyun.com/pypi/simple.
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=100

# LiteLLM control-plane secrets. Keep LITELLM_SALT_KEY stable after first boot,
# otherwise encrypted values already stored in PostgreSQL become unreadable.
LITELLM_MASTER_KEY=sk-change-me-master
LITELLM_SALT_KEY=sk-change-me-stable-salt
POSTGRES_PASSWORD=change-me-postgres

# Paply desktop authentication. Clients receive a short-lived Paply login
# access token; these two secrets stay server-side and must be different from
# every LiteLLM/provider key.
PAPLY_AUTH_JWT_SECRET=change-me-paply-login-signing-secret
PAPLY_AUTH_JWT_ISSUER=paply
PAPLY_AUTH_JWT_AUDIENCE=paplyai-gateway
PAPLY_AUTH_ACCESS_TOKEN_SECONDS=3600
PAPLY_AUTH_REFRESH_TOKEN_SECONDS=2592000
PAPLY_LITELLM_SERVICE_TOKEN=change-me-internal-service-token
PAPLY_DEFAULT_USER_BUDGET=20
PAPLY_DEFAULT_USER_BUDGET_DURATION=30d

# Upstream deployments and provider credentials are maintained in the Paply
# Gateway model page and encrypted by LiteLLM in PostgreSQL. Multiple paply-chat
# deployments load-balance across new sessions and remain sticky within each
# session; paply-vision and paply-image may load-balance per request. Do not put
# provider keys in this file.

# PaplyAI 技能正式制品存放在私有阿里云 OSS。深圳同地域 ECS 使用内网
# Endpoint；给 ECS 绑定仅允许访问 paplyai-skills Bucket/skills 前缀的 RAM 角色。
PAPLY_SKILLS_STORAGE=oss
PAPLY_SKILLS_OSS_ENDPOINT=https://oss-cn-shenzhen-internal.aliyuncs.com
PAPLY_SKILLS_OSS_REGION=cn-shenzhen
PAPLY_SKILLS_OSS_BUCKET=paplyai-skills
PAPLY_SKILLS_OSS_PREFIX=skills
PAPLY_SKILLS_OSS_CREDENTIALS=ecs_ram_role
PAPLY_SKILLS_OSS_ECS_ROLE_NAME=
PAPLY_SKILLS_GITHUB_REPOSITORY=PaplyAI/paplyai-skills
PAPLY_SKILLS_GITHUB_REF=main
PAPLY_SKILLS_GITHUB_CATALOG_PATH=catalog.json
# 私有仓库或匿名 GitHub API 配额不足时，在服务器设置只读 Contents Token。
PAPLY_SKILLS_GITHUB_TOKEN=

# 本地开发可改为 local，并将两个仓库保持为同级目录。
PAPLY_SKILLS_CATALOG_HOST_PATH=../paplyai-skills

# Internal service settings normally do not need changing under Compose.
PAPLY_LITELLM_URL=http://litellm:4000
PAPLY_MODELS_CONFIG_PATH=/app/config/paply-models.yaml
PAPLY_SKILLS_CATALOG_PATH=/catalog/catalog.json
PAPLY_UPSTREAM_TIMEOUT_SECONDS=600
REDIS_PASSWORD=change-me-redis

# Paply 中文管理台默认只绑定本机。仅在受控测试环境需要公网直连时，
# 才设置为 0.0.0.0，并同时通过云安全组限制访问来源；正式环境应使用 HTTPS。
PAPLY_ADMIN_BIND_ADDRESS=127.0.0.1
PAPLY_ADMIN_USERNAME=paply_test
PAPLY_ADMIN_PASSWORD=change-me-admin-password
PAPLY_ADMIN_SESSION_SECRET=change-me-admin-session-secret

# LiteLLM 原生高级运维后台账号。普通使用请访问 Paply 中文管理台。
LITELLM_UI_USERNAME=paply_test
LITELLM_UI_PASSWORD=change-me-litellm-ui-password
