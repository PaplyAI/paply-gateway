# Copy to .env and replace every value marked `change-me` before starting.
PAPLY_ENVIRONMENT=development
COMPOSE_PROJECT_NAME=paply-token-gateway
PAPLY_PUBLIC_BASE_URL=http://127.0.0.1:4387

# Python package index used only while building the Gateway/Admin image.
# Domestic servers can use https://mirrors.aliyun.com/pypi/simple.
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=100

# LiteLLM control-plane secrets. Keep LITELLM_SALT_KEY stable after first boot,
# otherwise encrypted values already stored in PostgreSQL become unreadable.
LITELLM_MASTER_KEY=sk-change-me-master
LITELLM_SALT_KEY=sk-change-me-stable-salt
POSTGRES_PASSWORD=change-me-postgres

# Paply desktop authentication. Clients receive a short-lived Paply login
# access token; these two secrets stay server-side and must be different from
# every LiteLLM/provider key.
PAPLY_AUTH_JWT_SECRET=change-me-paply-login-signing-secret
PAPLY_AUTH_JWT_ISSUER=paply
PAPLY_AUTH_JWT_AUDIENCE=paply-gateway
PAPLY_LITELLM_SERVICE_TOKEN=change-me-internal-service-token

# Upstream provider configuration. The public model aliases remain stable while
# these values can be changed without a desktop release.
PAPLY_CHAT_UPSTREAM_MODEL=openai/gpt-5-mini
PAPLY_VISION_UPSTREAM_MODEL=openai/gpt-5-mini
PAPLY_IMAGE_UPSTREAM_MODEL=openai/gpt-image-1
OPENAI_API_KEY=sk-change-me-provider
# 可分别切换聊天、识图和生图上游，便于国内部署接入不同兼容服务。
# 未配置独立 Key 时，Compose 会回退到 OPENAI_API_KEY。
PAPLY_CHAT_API_BASE=https://api.openai.com/v1
PAPLY_CHAT_API_KEY=
PAPLY_VISION_API_BASE=https://api.openai.com/v1
PAPLY_VISION_API_KEY=
PAPLY_IMAGE_API_BASE=https://api.openai.com/v1
PAPLY_IMAGE_API_KEY=

# PaplyAI 官方技能目录仓库。默认值适用于两个仓库同级放置的本地环境。
PAPLY_SKILLS_CATALOG_HOST_PATH=../paplyai-skills-catalog

# Internal service settings normally do not need changing under Compose.
PAPLY_LITELLM_URL=http://litellm:4000
PAPLY_MODELS_CONFIG_PATH=/app/config/paply-models.yaml
PAPLY_SKILLS_CATALOG_PATH=/catalog/catalog.json
PAPLY_UPSTREAM_TIMEOUT_SECONDS=600
REDIS_PASSWORD=change-me-redis

# Paply 中文管理台默认只绑定本机。仅在受控测试环境需要公网直连时，
# 才设置为 0.0.0.0，并同时通过云安全组限制访问来源；正式环境应使用 HTTPS。
PAPLY_ADMIN_BIND_ADDRESS=127.0.0.1
PAPLY_ADMIN_USERNAME=paply_test
PAPLY_ADMIN_PASSWORD=change-me-admin-password
PAPLY_ADMIN_SESSION_SECRET=change-me-admin-session-secret

# LiteLLM 原生高级运维后台账号。普通使用请访问 Paply 中文管理台。
LITELLM_UI_USERNAME=paply_test
LITELLM_UI_PASSWORD=change-me-litellm-ui-password
